{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Migration Assistant",
  "mainBinaryName": "MigrationAssistant",
  "version": "0.1.0",
  "identifier": "com.migrationassistant.portable",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Migration Assistant",
        "width": 1366,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "publisher": "Migration Assistant",
    "copyright": "MIT licensed",
    "category": "Utility",
    "shortDescription": "Authorized, local-only Windows profile migration",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  },
  "plugins": {}
}
